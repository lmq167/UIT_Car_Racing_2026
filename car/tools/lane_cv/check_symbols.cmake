if(NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "Khong co chuong trinh: ${PROGRAM}")
endif()
if(NOT NM)
    find_program(NM NAMES nm llvm-nm)
endif()
if(NOT NM)
    message(FATAL_ERROR "Can nm/llvm-nm de kiem ky hieu, khong bo qua")
endif()
execute_process(COMMAND "${NM}" -C "${PROGRAM}" RESULT_VARIABLE code
    OUTPUT_VARIABLE symbols ERROR_VARIABLE errors TIMEOUT 15)
if(NOT "${code}" STREQUAL "0")
    message(FATAL_ERROR "Khong doc duoc ky hieu: ${errors}")
endif()
if(symbols STREQUAL "" OR errors MATCHES "no symbols")
    message(FATAL_ERROR "Khong co bang ky hieu de kiem tra; dung binary chua strip")
endif()
if(symbols MATCHES "Motor|Servo|IMU|ToF|Camera|Backend")
    message(FATAL_ERROR "Phat hien ky hieu phan cung/dieu khien trong chuong trinh")
endif()
message(STATUS "Khong co ky hieu phan cung/dieu khien bi cam")
