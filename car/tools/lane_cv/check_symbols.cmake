if(NOT EXISTS "${PROGRAM}")
    message(FATAL_ERROR "Khong co chuong trinh: ${PROGRAM}")
endif()
if(NOT NM)
    find_program(NM NAMES nm llvm-nm)
endif()
if(NOT NM)
    message(FATAL_ERROR "Can nm/llvm-nm de kiem ky hieu, khong bo qua")
endif()
find_program(STRINGS NAMES strings llvm-strings)
find_program(LDD ldd)
if(NOT STRINGS OR NOT LDD)
    message(FATAL_ERROR "Can strings va ldd de kiem them binary, khong bo qua")
endif()
set(forbidden "Motor|Servo|IMU|ToF|Camera|Backend|OLED|app_core|I2C|UART|i2c|uart")
execute_process(COMMAND "${NM}" -C "${PROGRAM}" RESULT_VARIABLE code
    OUTPUT_VARIABLE symbols ERROR_VARIABLE errors TIMEOUT 15)
string(TOLOWER "${symbols}${errors}" nm_message)
if(NOT "${code}" STREQUAL "0" AND NOT ("${code}" STREQUAL "1" AND nm_message MATCHES "no symbols"))
    message(FATAL_ERROR "Khong doc duoc ky hieu: ${errors}")
endif()
string(STRIP "${symbols}" symbol_table)
if(symbol_table STREQUAL "" OR nm_message MATCHES "no symbols")
    message(STATUS "nm rong/no symbols: bat buoc kiem them strings va ldd")
endif()
if(symbols MATCHES "${forbidden}")
    message(FATAL_ERROR "Phat hien ky hieu phan cung/dieu khien trong chuong trinh")
endif()
# chuoi va thu vien la bang chung phu bat buoc, ke ca khi nm rong.
execute_process(COMMAND "${STRINGS}" "${PROGRAM}" RESULT_VARIABLE code
    OUTPUT_VARIABLE contents ERROR_VARIABLE errors TIMEOUT 15)
string(STRIP "${contents}" contents)
if(NOT "${code}" STREQUAL "0" OR contents STREQUAL "")
    message(FATAL_ERROR "Khong doc duoc chuoi lam bang chung: ${errors}")
endif()
if(contents MATCHES "${forbidden}")
    message(FATAL_ERROR "Phat hien chuoi phan cung/dieu khien bi cam")
endif()
execute_process(COMMAND "${LDD}" "${PROGRAM}" RESULT_VARIABLE code
    OUTPUT_VARIABLE libraries ERROR_VARIABLE errors TIMEOUT 15)
string(STRIP "${libraries}" libraries)
string(TOLOWER "${libraries}" library_message)
if(NOT "${code}" STREQUAL "0" OR libraries STREQUAL "" OR library_message MATCHES "not found")
    message(FATAL_ERROR "Khong doc duoc thu vien hoac thieu thu vien: ${libraries} ${errors}")
endif()
string(REPLACE "\n" ";" library_lines "${libraries}")
foreach(line ${library_lines})
    if(line MATCHES "^[ \t]*([^ \t]+)")
        get_filename_component(library_name "${CMAKE_MATCH_1}" NAME)
        string(TOLOWER "${library_name}" library_name)
        if(library_name MATCHES "motor|servo|imu|tof|backend|oled|app_core|wiringpi|pigpio|i2c|uart|gpiod|bno055|vl53|pca9685|sh1106")
            message(FATAL_ERROR "Phat hien thu vien thiet bi: ${library_name}")
        endif()
    endif()
endforeach()
message(STATUS "nm/strings/ldd: khong co ky hieu, chuoi hay thu vien thiet bi bi cam")
