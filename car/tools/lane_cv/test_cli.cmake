# Mỗi lượt dùng thư mục riêng, không xoá hay ghi đè kết quả cũ.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(root "${TEST_ROOT}/${nonce}")
function(expect code)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE actual
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT "${actual}" STREQUAL "${code}")
        message(FATAL_ERROR "Ma thoat ${actual}, can ${code}: ${ARGN}\n${output}\n${error}")
    endif()
endfunction()
expect(0 --self-test "${root}")
expect(0 --help)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --smax nan)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --morph-kernel 2)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --fit-min-rows 3)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --vmin 200junk)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --fit unknown)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --unknown 1)
expect(1 --in "${root}/lanes.png" --out-dir "${root}/bad" --roi-tl-x 1 --roi-tl-y 1)
expect(3 --in "${root}/lanes.png" --out-dir "${root}/threshold-cli" --left-min-area 138240)
file(READ "${root}/threshold-cli/000001_lanes.png/metrics.json" threshold)
if(NOT threshold MATCHES "\"left-min-area\":138240")
    message(FATAL_ERROR "JSON khong ghi nguong da truyen")
endif()
expect(0 --in "${root}/lanes.png" --out-dir "${root}/cli" --no-steps --smax 75)
if(EXISTS "${root}/cli/000001_lanes.png/steps.png")
    message(FATAL_ERROR "--no-steps van ghi bang cac buoc")
endif()
expect(4 --in "${root}/lanes.png" --out-dir "${root}/cli")
expect(3 --in "${root}/blank.png" --out-dir "${root}/blank-cli")
file(READ "${root}/blank-cli/000001_blank.png/metrics.json" blank)
if(NOT blank MATCHES "insufficient_evidence" OR NOT blank MATCHES "\"midpoint_y\":null")
    message(FATAL_ERROR "Anh thieu bang chung van bao trung diem hop le")
endif()
expect(2 --in "${root}/broken.png" --out-dir "${root}/broken-cli")
expect(2 --in "${root}/missing.png" --out-dir "${root}/missing-cli")
file(MAKE_DIRECTORY "${root}/empty")
expect(2 --in "${root}/empty" --out-dir "${root}/empty-cli")
file(MAKE_DIRECTORY "${root}/batch")
configure_file("${root}/lanes.png" "${root}/batch/same.png" COPYONLY)
configure_file("${root}/lanes.png" "${root}/batch/same.bmp" COPYONLY)
expect(0 --in "${root}/batch" --out-dir "${root}/batch-cli")
foreach(name same.png same.bmp)
    file(GLOB outputs "${root}/batch-cli/*_${name}/metrics.json")
    list(LENGTH outputs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Trung ten hoac mat ket qua: ${name}")
    endif()
endforeach()
configure_file("${root}/broken.png" "${root}/batch/broken.png" COPYONLY)
configure_file("${root}/blank.png" "${root}/batch/blank.png" COPYONLY)
expect(2 --in "${root}/batch" --out-dir "${root}/batch-errors")
message(STATUS "Kiem thu dong lenh DAT: ${root}")
